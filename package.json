{
  "name": "gambknd",
  "version": "0.1.0",
  "private": true,
  "description": "Gamb backend — token-only cricket prediction platform (API, realtime, workers)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "infra:start": "node scripts/infra.mjs start",
    "infra:stop": "node scripts/infra.mjs stop",
    "infra:status": "node scripts/infra.mjs status",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "worker": "tsx watch --clear-screen=false src/workers/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx src/scripts/replay-match.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.20.0",
    "mongoose": "^8.24.5",
    "nodemailer": "^10.1.2",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.4",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
